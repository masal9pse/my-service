# Supabase (PostgreSQL) 接続文字列
# [YOUR-PROJECT-REF] を Supabase の Project Ref に、
# [YOUR-PASSWORD] を Supabase のデータベースパスワードに置き換えてください。

# 推奨: DIRECT_URL (セッションプール / ポート5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# または DATABASE_URL (トランザクションプール / ポート6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase プロジェクトURL (JWT署名検証用 JWKS の自動取得)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# フロントエンド用 (Supabase Auth サインイン)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

PORT=8080